<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Discovery</title>
    <link rel="stylesheet" href="/style/main.css">
</head>
<body>
<div class="header">…dein Header…</div>
<div class="container">
    <h1>Discovery</h1>

    <div class="search-container">
        <form action="/discovery" method="get">
            <input type="text" name="search" placeholder="Search…" value="<%= currentSearch %>">
            <button type="submit">Search</button>
        </form>
    </div>

    <% function preview(boards, title, key) {
        if (!boards || boards.length === 0) return; %>
    <section class="category-section">
        <h2><%= title %></h2>
        <div class="board-grid">
            <% boards.slice(0,5).forEach(function(b) { %>
                <div class="board-card">
                    <div class="header-container">
                        <img src="/<%= b.header_image %>" class="header-image"
                             onerror="this.onerror=null;this.src='/uploads/default_header.png'">
                        <img src="/<%= b.profile_image %>" class="profile-image"
                             onerror="this.onerror=null;this.src='/uploads/default_profile.png'">
                    </div>
                    <div class="board-info">
                        <h3><%= b.name %></h3>
                        <p><%= b.description %></p>
                        <a href="/board/<%= b.id %>">Open Board</a>
                    </div>
                </div>
            <% }); %>
        </div>
        <% if (boards.length > 5) { %>
            <a href="/discovery/category/<%= key %>" class="show-all-link">
                Alle anzeigen &rarr;
            </a>
        <% } %>
    </section>
    <% } %>

    <% preview(artBoards,    'Art',    'art'); %>
    <% preview(writingBoards,'Writing','writing'); %>
    <% preview(comicBoards,  'Comic',  'comic'); %>

    <%
    // “All” nach Hashtag-Gruppen, ohne TS-Typen
    var groups = {};
    allBoards.forEach(function(b) {
        if (b.hashtag_list) {
            b.hashtag_list.split(',').map(function(s){ return s.trim(); }).filter(function(s){ return s; })
                    .forEach(function(tag) {
                        var slug = tag.toLowerCase().replace(/\W/g,'-');
                        if (!groups[slug]) groups[slug] = { hashtag: tag, boards: [] };
                        groups[slug].boards.push(b);
                    });
        } else {
            if (!groups.uncategorized) groups.uncategorized = { hashtag: 'Uncategorized', boards: [] };
            groups.uncategorized.boards.push(b);
        }
    });
    Object.keys(groups).forEach(function(slug) {
        var group = groups[slug];
        var title = slug === 'uncategorized'
                ? 'Others'
                : slug.split('-').map(function(w){return w.charAt(0).toUpperCase()+w.slice(1);} ).join(' ');
    %>
    <section class="category-section">
        <h3><%= title %></h3>
        <div class="board-grid">
            <% group.boards.slice(0,5).forEach(function(b) { %>
                <div class="board-card">
                    <div class="header-container">
                        <img src="/<%= b.header_image %>" class="header-image"
                             onerror="this.onerror=null;this.src='/uploads/default_header.png'">
                        <img src="/<%= b.profile_image %>" class="profile-image"
                             onerror="this.onerror=null;this.src='/uploads/default_profile.png'">
                    </div>
                    <div class="board-info">
                        <h3><%= b.name %></h3>
                        <p><%= b.description %></p>
                        <a href="/board/<%= b.id %>">Open Board</a>
                    </div>
                </div>
            <% }); %>
        </div>
        <% if (group.boards.length > 5) { %>
            <a href="/discovery/category/all-<%= slug %>" class="show-all-link">
                Alle anzeigen &rarr;
            </a>
        <% } %>
    </section>
    <% }); %>
</div>
</body>
</html>
